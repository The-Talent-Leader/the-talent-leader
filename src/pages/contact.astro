---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Us — The Talent Leader">
  <section class="page-hero">
    <div class="container">
      <span class="section-label">Get in Touch</span>
      <h1>Contact Us</h1>
      <p class="page-intro">
        Ready to explore how we can support your HR team? Send us a message and we’ll be in touch.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2>Start a conversation</h2>
        <p>
          We work with Heads of HR, CHROs, and their direct reports across Southeast Asia and Australia.
          Whether you are exploring a public programme, in-house capability build, or online delivery,
          we’d love to hear what you are working on.
        </p>
        <div class="gold-line"></div>
        <p class="contact-note">
          <em>Fields marked with an asterisk (*) are required.</em>
        </p>
      </div>

      <form class="contact-form" id="contact-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="b91e9175-25e1-4240-a732-cd521cee003f" />
        <input type="hidden" name="subject" value="New contact form submission — The Talent Leader" />
        <input type="hidden" name="from_name" value="The Talent Leader Website" />
        <div class="form-group">
          <label for="name">Name *</label>
          <input type="text" id="name" name="name" required />
        </div>
        <div class="form-group">
          <label for="mobile">Mobile *</label>
          <input type="tel" id="mobile" name="mobile" required />
        </div>
        <div class="form-group">
          <label for="email">Email *</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="form-group">
          <label for="company">Company *</label>
          <input type="text" id="company" name="company" required />
        </div>
        <div class="form-group">
          <label for="message">Comment *</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send Message</button>
        <p class="form-feedback" id="form-feedback"></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form');
  const feedback = document.getElementById('form-feedback');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    feedback.textContent = '';

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    if (!data.name?.trim() || !data.mobile?.trim() || !data.email?.trim() || !data.company?.trim() || !data.message?.trim()) {
      feedback.textContent = 'Please fill in all required fields.';
      feedback.style.color = '#b45c5c';
      return;
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(data.email)) {
      feedback.textContent = 'Please enter a valid email address.';
      feedback.style.color = '#b45c5c';
      return;
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await response.json();
      if (response.ok && result.success) {
        feedback.textContent = 'Thank you — your message has been sent. We'll be in touch soon.';
        feedback.style.color = '#3a7d44';
        form.reset();
      } else {
        feedback.textContent = result.message || 'Something went wrong. Please try again or email us directly.';
        feedback.style.color = '#b45c5c';
      }
    } catch {
      feedback.textContent = 'Something went wrong. Please try again or email us directly.';
      feedback.style.color = '#b45c5c';
    }
  });
</script>

<style>
  .page-hero {
    background-color: var(--navy);
    color: var(--off-white);
    padding: 6rem 0 4rem;
    text-align: center;
  }
  .page-hero h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    margin: 1rem 0 1.25rem;
  }
  .page-intro {
    max-width: 560px;
    margin: 0 auto;
    opacity: 0.8;
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .section { padding: 5rem 0; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 4rem;
    align-items: start;
  }
  .contact-info h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--navy);
    margin-bottom: 1rem;
  }
  .contact-info p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--charcoal);
    opacity: 0.9;
    margin-bottom: 1.5rem;
  }
  .contact-info .gold-line { margin: 1.5rem 0; }
  .contact-note {
    font-size: 0.85rem !important;
    opacity: 0.7 !important;
  }

  .contact-form {
    background-color: var(--stone);
    padding: 2.5rem;
    border: 1px solid rgba(197, 155, 99, 0.2);
  }
  .form-group {
    margin-bottom: 1.25rem;
  }
  .form-group label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--navy);
    margin-bottom: 0.4rem;
  }
  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--charcoal);
    background-color: var(--cream);
    border: 1px solid rgba(197, 155, 99, 0.3);
    outline: none;
    transition: border-color 0.2s ease;
  }
  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--gold);
  }
  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }
  .contact-form button {
    width: 100%;
    justify-content: center;
  }
  .form-feedback {
    margin-top: 1rem;
    font-size: 0.9rem;
    min-height: 1.4em;
  }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>
